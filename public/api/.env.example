APP_NAME=Biblioteka
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8083
APP_TIMEZONE=UTC

LOG_CHANNEL=stack
LOG_SLACK_WEBHOOK_URL=

# SQLite. By default Lumen uses public/api/database/database.sqlite.
# Set an absolute path here if you keep the database elsewhere.
DB_CONNECTION=sqlite
# DB_DATABASE=

# JWT keys. Generate them with:
#   php scripts/generate_jwt_keys.php
JWT_PRIVATE_KEY=""
JWT_PUBLIC_KEY=""
JWT_COOKIE="biblioteka_jwt"
JWT_COOKIE_TIMEOUT=86400

CACHE_DRIVER=file
QUEUE_CONNECTION=sync

ADMIN_LOGIN=admin
ADMIN_PASSWORD=change_me
